.768,3269.139,1.0]},"text_style":{"font_family":"serif","font_size":14.0,"font_weight":500,"font_style":"regular","color":{"r":0.898,"g":0.378,"b":0.0,"a":1.0},"max_width":542.5645265677151,"alignment":"start","ranged_text_attributes":[{"range":{"start":0,"end":545},"attribute":{"text_color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0}}}]}}},"version":1},{"value":{"brushstroke":{"path":{"start":{"pos":[112.251,3494.436],"pressure":0.317},"segments":[{"lineto":{"end":{"pos":[112.251,3494.436],"pressure":0.317}}},{"lineto":{"end":{"pos":[112.244,3494.421],"pressure":0.326}}},{"lineto":{"end":{"pos":[112.233,3494.402],"pressure":0.34}}},{"lineto":{"end":{"pos":[112.217,3494.372],"pressure":0.361}}},{"lineto":{"end":{"pos":[112.186,3494.315],"pressure":0.4}}},{"lineto":{"end":{"pos":[112.161,3494.27],"pressure":0.422}}},{"lineto":{"end":{"pos":[112.135,3494.225],"pressure":0.441}}},{"lineto":{"end":{"pos":[112.081,3494.143],"pressure":0.475}}},{"lineto":{"end":{"pos":[112.051,3494.099],"pressure":0.493}}},{"lineto":{"end":{"pos":[112.021,3494.058],"pressure":0.517}}},{"lineto":{"end":{"pos":[112.009,3494.04],"pressure":0.532}}},{"lineto":{"end":{"pos":[111.983,3494.009],"pressure":0.544}}},{"lineto":{"end":{"pos":[111.962,3493.987],"pressure":0.55}}},{"lineto":{"end":{"pos":[111.943,3493.981],"pressure":0.553}}},{"lineto":{"end":{"pos":[111.941,3494.007],"pressure":0.562}}},{"lineto":{"end":{"pos":[111.957,3494.077],"pressure":0.562}}},{"lineto":{"end":{"pos":[111.994,3494.199],"pressure":0.557}}},{"lineto":{"end":{"pos":[112.048,3494.369],"pressure":0.551}}},{"lineto":{"end":{"pos":[112.11,3494.564],"pressure":0.527}}},{"lineto":{"end":{"pos":[112.112,3494.57],"pressure":0.526}}},{"lineto":{"end":{"pos":[112.187,3494.806],"pressure":0.481}}},{"lineto":{"end":{"pos":[112.245,3494.987],"pressure":0.375}}},{"lineto":{"end":{"pos":[112.283,3495.108],"pressure":0.287}}},{"lineto":{"end":{"pos":[112.307,3495.181],"pressure":0.234}}},{"lineto":{"end":{"pos":[112.319,3495.219],"pressure"